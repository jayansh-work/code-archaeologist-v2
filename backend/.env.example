# Required for Ask Code Archaeologist. When unset, Git analysis still works
# and AI investigation shows as unavailable. Never commit a real key.
OPENROUTER_API_KEY=

# OpenRouter model slug. Swap this without changing code.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional comma-separated fallback slugs if the primary model is unavailable.
# Keep this list short. Free `:free` slugs can still be rate limited.
OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku

# Optional OpenRouter attribution. HTTP-Referer is sent only when SITE_URL is set.
OPENROUTER_APP_NAME=Code Archaeologist
OPENROUTER_SITE_URL=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
