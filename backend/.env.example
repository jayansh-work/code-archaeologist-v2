# Required for Ask Code Archaeologist. When unset, Git analysis still works and AI investigation shows as unavailable.
GEMINI_API_KEY=

# Optional. GOOGLE_API_KEY is also accepted if GEMINI_API_KEY is empty.
GOOGLE_API_KEY=

# Optional. Used only when an API key is set. gemini-2.0-flash is shut down.
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
